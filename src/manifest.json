{
	"$schema": "https://json.schemastore.org/chrome-manifest.json",
	"chromium:manifest_version": 3,
	"firefox:manifest_version": 2,
	"version": "0.0.1",
	"permissions": ["storage"],
	"firefox:browser_specific_settings": {
		"gecko": {
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"name": "canvas-to-tasks",
	"description": "Adds a sidebar panel to the browser with a simple page.",
	"icons": {
		"16": "images/icon.png",
		"32": "images/icon.png",
		"48": "images/icon.png",
		"64": "images/icon.png",
		"128": "images/icon.png"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content/canvas/script.ts"]
		},
		{
			"matches": ["https://calendar.google.com/*", "https://tasks.google.com/*"],
			"js": ["content/google/script.ts"]
		}
	],
	"chromium:action": { "default_popup": "./action/index.html" },
	"firefox:browser_action": { "default_popup": "./action/index.html" },
	"background": {
		"chromium:service_worker": "background.ts",
		"firefox:scripts": ["background.ts"]
	}
}